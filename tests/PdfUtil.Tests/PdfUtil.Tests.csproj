<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(PdfUtilTestTargetFrameworks)</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/PdfUtil/PdfUtil.csproj" />
    <ProjectReference Include="../../src/PdfUtil.Extensions.DependencyInjection/PdfUtil.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="..\..\src\PdfUtil.Signatures\PdfUtil.Signatures.csproj" />
    <ProjectReference Include="..\..\src\PdfUtil.Conversion\PdfUtil.Conversion.csproj" />
  </ItemGroup>

  <!-- The command-line tool is .NET 8 only. -->
  <ItemGroup Condition="!$(TargetFramework.StartsWith('net4'))">
    <ProjectReference Include="..\..\src\PdfUtil.Cli\PdfUtil.Cli.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('net4'))">
    <!-- The command-line tool is .NET 8 only, and the test certificates need .NET 8 APIs. -->
    <Compile Remove="CliTests.cs" />
    <Compile Remove="SignatureTests.cs" />
    <Compile Remove="CertificateSecurityTests.cs" />
    <Compile Remove="Infrastructure/TestCertificates.cs" />
    <Compile Remove="Rfc3161CompatTests.cs" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
