@page "/validate"
@inherits OperationPage
@inject IPdfAnalyzer Analyzer
@inject IPdfCleaner Cleaner

<PageTitle>Validate and repair · PdfUtil sample</PageTitle>

<h1 class="mb-4">Validate and repair</h1>

<div class="row g-4">
    <div class="col-lg-7">
        <PdfFileInput File="_file" FileChanged="OnFileChanged" Disabled="Busy" />
        <PasswordInput Label="Password (optional)" @bind-Value="_password" Disabled="Busy" AutoComplete="current-password"
                       Help="Needed to check the contents of a protected file." />
        <div class="form-check mb-3">
            <input class="form-check-input" type="checkbox" id="streams" @bind="_checkStreams" disabled="@Busy" />
            <label class="form-check-label" for="streams">Decode every stream (thorough, slower)</label>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-primary" @onclick="ValidateAsync" disabled="@(Busy || _file is null)">Validate</button>
            <button class="btn btn-outline-primary" @onclick="RepairAsync" disabled="@(Busy || _file is null)">Repair</button>
            @if (Busy)
            {
                <button class="btn btn-outline-secondary" @onclick="Cancel">Cancel</button>
            }
        </div>
        <ProgressDisplay Progress="CurrentProgress" />

        @if (_report is not null)
        {
            <div class="alert @(_report.IsValid ? "alert-success" : "alert-warning") mt-4">
                @(_report.IsValid ? "No errors found." : "Errors found: the file may not open correctly everywhere. Try Repair.")
                @_report.Issues.Count issue(s), @_report.ObjectCount objects@(_report.PageCount is int pages ? $", {pages} pages" : "").
            </div>
            @if (_report.Issues.Count > 0)
            {
                <table class="table table-sm">
                    <thead><tr><th>Severity</th><th>Code</th><th>Object</th><th>Message</th></tr></thead>
                    <tbody>
                        @foreach (var issue in _report.Issues.Take(300))
                        {
                            <tr class="@(issue.Severity == PdfValidationSeverity.Error ? "table-danger" : issue.Severity == PdfValidationSeverity.Warning ? "table-warning" : "")">
                                <td>@issue.Severity</td><td><code>@issue.Code</code></td><td>@issue.ObjectNumber</td><td>@issue.Message</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        }
    </div>

    <div class="col-lg-5">
        @if (Error is not null)
        {
            <div class="alert alert-danger" role="alert">@Error</div>
        }

        @if (_repair is not null && _output is not null)
        {
            <OperationResult Title="@(_repair.WasDamaged ? "Repaired" : "Rewritten (no damage found)")" FileName="@OutputName(_file!, "-repaired")" Data="_output"
                             Details="@(new[] { ("Pages", _repair.PageCount.ToString()), ("Repairs", _repair.Repairs.Count == 0 ? "None needed" : string.Join("; ", _repair.Repairs)) })"
                             Warnings="_repair.Warnings" />
        }
    </div>
</div>

@code {
    private UploadedPdf? _file;
    private string? _password;
    private bool _checkStreams = true;
    private PdfValidationReport? _report;
    private PdfRepairResult? _repair;
    private byte[]? _output;

    private void OnFileChanged(UploadedPdf? file)
    {
        _file = file;
        _report = null;
        _repair = null;
        _output = null;
        Error = null;
    }

    private Task ValidateAsync() => RunAsync(async (ct, progress) =>
    {
        var file = _file!;
        var options = new PdfValidationOptions { Password = Optional(_password), CheckStreams = _checkStreams, Progress = progress };
        _report = await Task.Run(async () =>
        {
            using var stream = file.OpenRead();
            return await Analyzer.ValidateAsync(stream, options, ct);
        });
    });

    private Task RepairAsync() => RunAsync(async (ct, progress) =>
    {
        var options = new PdfRepairOptions { Password = Optional(_password), Progress = progress };
        (_repair, _output) = await Produce(_file!, (input, output) => Cleaner.RepairAsync(input, output, options, ct));
    });
}
