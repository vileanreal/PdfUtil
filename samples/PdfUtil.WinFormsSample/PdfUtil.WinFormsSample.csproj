<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A Windows Forms app on .NET Framework 4.8 that checks the net462 build of PdfUtil. It needs the .NET 10 SDK
    (Visual Studio 2026), like the net462 build itself. With an older SDK the libraries have no net462 build, so this
    project then builds only OldSdk/Program.cs, which says what is needed, and the rest of PdfUtil.sln still builds.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>PdfUtil.WinFormsSample</RootNamespace>
    <AssemblyName>PdfUtil.WinFormsSample</AssemblyName>
    <IsPackable>false</IsPackable>
    <PdfUtilNetFramework Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(MSBuildVersion)', '18.0'))">true</PdfUtilNetFramework>
  </PropertyGroup>

  <ItemGroup Condition="'$(PdfUtilNetFramework)' != 'true'">
    <Compile Remove="*.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(PdfUtilNetFramework)' == 'true'">
    <Compile Remove="OldSdk/**" />
    <ProjectReference Include="../../src/PdfUtil/PdfUtil.csproj" />
    <ProjectReference Include="../../src/PdfUtil.Signatures/PdfUtil.Signatures.csproj" />
    <ProjectReference Include="../../src/PdfUtil.Conversion/PdfUtil.Conversion.csproj" />
    <ProjectReference Include="../../src/PdfUtil.Extensions.DependencyInjection/PdfUtil.Extensions.DependencyInjection.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

</Project>
