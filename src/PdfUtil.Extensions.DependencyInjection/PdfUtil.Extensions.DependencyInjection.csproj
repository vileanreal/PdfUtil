<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>PdfUtil.Extensions.DependencyInjection</RootNamespace>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>$(PdfUtilLibraryTargetFrameworks)</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>PdfUtil.Extensions.DependencyInjection</PackageId>
    <Description>Microsoft.Extensions.DependencyInjection registration and ILogger integration for PdfUtil.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PdfUtil/PdfUtil.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfUtil.Signatures\PdfUtil.Signatures.csproj" />
    <ProjectReference Include="..\PdfUtil.Conversion\PdfUtil.Conversion.csproj" />
  </ItemGroup>

</Project>
